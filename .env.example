# ==============================================================================
# ProofEngine Environment Configuration
# Copy this file to `.env` (which is strictly gitignored) for local execution.
# ==============================================================================

# --- LLM Provider Settings ---
# Options: openrouter | anthropic | google | openai
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash-lite

# Optional provider overrides:
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
# OPENAI_API_KEY=

# --- Active Niche ---
# Set the default active niche pack (must exist in niches/<NICHE>/niche.json)
NICHE=example-finance

# --- Text-to-Speech (TTS) ---
# Options: edge-tts | elevenlabs
TTS_PROVIDER=edge-tts
# ELEVENLABS_API_KEY=

# --- Visual & Stock Footage ---
# Pexels API key for automated 9:16 vertical B-roll footage (optional)
# If left empty, ProofEngine automatically generates aesthetic vertical motion backgrounds.
PEXELS_API_KEY=

# --- ProofEngine API & Dashboard ---
# Port for FastAPI server (default: 8000)
PORT=8000
# Optional shared API secret for mutating endpoints (POST/PATCH/DELETE)
ENGINE_API_KEY=

# --- Output Directory ---
OUTPUT_DIR=./output
