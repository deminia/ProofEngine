# ==============================================================================
# ProofEngine Environment Configuration
# Copy this file to `.env` (which is strictly gitignored) for local execution.
# ==============================================================================

# --- LLM Provider Settings ---
# Options: openrouter | anthropic | google | openai
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash-lite

# Optional provider overrides:
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
# OPENAI_API_KEY=

# --- Active Niche ---
# Set the default active niche pack (must exist in niches/<NICHE>/niche.json)
NICHE=example-finance

# --- Text-to-Speech (TTS) ---
# Options: edge-tts (free, default) | elevenlabs
TTS_PROVIDER=edge-tts
# ELEVENLABS_API_KEY=

# --- Visual & Stock Footage ---
# Pexels API key for automated 9:16 vertical B-roll footage (optional)
# If left empty, ProofEngine automatically generates aesthetic vertical motion backgrounds.
PEXELS_API_KEY=

# --- Multi-Platform Publishing (engine/publishing.py) ---
# NOTE: dry_run=True is enabled by default across all platforms.
# In dry-run mode, full API payloads are built and validated with zero network calls,
# requiring NO developer keys or app approvals.
# Fill in the credentials below only when performing live distribution (dry_run=False).

# YouTube (Data API v3 - Google Cloud Console OAuth)
YOUTUBE_CLIENT_SECRET_FILE=
YOUTUBE_TOKEN_FILE=
YOUTUBE_PRIVACY=public
YOUTUBE_CATEGORY=24

# TikTok (Content Posting API v2 - TikTok for Developers App Review)
TIKTOK_ACCESS_TOKEN=
TIKTOK_CREATOR_ID=

# Meta / Instagram & Facebook (Meta for Developers - Graph API Reels)
META_ACCESS_TOKEN=
META_IG_USER_ID=
META_PAGE_ID=

# X / Twitter (X Developer Portal - OAuth 1.0a User Context)
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# Shopee Video (Shopee Open Platform - Partner Approval)
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=
SHOPEE_SHOP_ID=
SHOPEE_ACCESS_TOKEN=
SHOPEE_REGION=TH

# --- ProofEngine API & Dashboard ---
# Port for FastAPI server (default: 8000)
PORT=8000
# Optional shared API secret for mutating endpoints (POST/PATCH/DELETE)
ENGINE_API_KEY=

# --- Output Directory ---
OUTPUT_DIR=./output
