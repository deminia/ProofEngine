# Dashboard env config — copy to `.env.local` (gitignored) for local dev.
# Vite injects every VITE_* var at build time via `import.meta.env`.

# --- Backend origin ---
# Leave empty in local dev → vite.config.js proxies `/api`, `/media`, `/ws`
# to http://localhost:8000. Set to a full URL (https://api.example.com) when
# the dashboard is deployed separately from the backend.
VITE_API_BASE_URL=

# --- API key (REQUIRED if backend has ENGINE_API_KEY set) ---
# Must match `ENGINE_API_KEY` in backend/.env exactly. The backend middleware
# in main.py rejects every POST/PATCH/PUT/DELETE with HTTP 401
# `{"detail":"missing or invalid API key"}` when this is missing or wrong.
# Symptom: GETs work (Queue/Scripts pages load) but Save/Approve/Rebuild/
# Reject buttons all fail with 401. The dashboard now surfaces the error
# in a toast — if you see one, fix this var and restart `npm run dev`.
# Leave empty when backend ENGINE_API_KEY is also empty (legacy/open mode).
VITE_API_KEY=
